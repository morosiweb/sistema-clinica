// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== PACIENTE (sin login) =====================
// Se identifica por DNI. Accede a sus turnos mediante un link personal
// permanente con un token aleatorio. Se guarda un hash (SHA-256) para poder
// buscar por el token que llega en la URL, y además una copia cifrada
// (AES-256-GCM) para poder reenviar el MISMO link si el paciente lo pierde,
// sin tener que invalidarlo ni crear uno nuevo (la contraseña de un usuario
// interno sí usa bcrypt irreversible porque ahí nunca hace falta reenviarla).

model Paciente {
  id                String            @id @default(cuid())
  dni               String            @unique
  nombre            String
  apellido          String
  telefono          String?
  email             String?
  fechaNacimiento   DateTime?
  obraSocial        String?
  // Ficha médica básica: la carga el médico tratante (o admin), campos
  // libres sin validación clínica estricta.
  pesoKg            Float?
  alturaCm          Float?
  grupoSanguineo    String?
  alergias          String?
  antecedentes      String?
  tokenAccesoHash   String            @unique
  tokenAccesoEnc    String
  tokenGeneradoEl   DateTime          @default(now())
  ausenciasSinAviso Int               @default(0)
  versionFicha      Int               @default(0)
  versionDatos      Int               @default(0)
  revisionesDatos   RevisionDatosPaciente[]
  borradores        BorradorClinico[]
  revisionesFicha   RevisionFicha[]
  turnos            Turno[]
  notasCompartidas  NotaPaciente[]
  archivos          ArchivoPaciente[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// ===================== MEDICOS Y AGENDA =====================

model Especialidad {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  medicos     Medico[]
  createdAt   DateTime @default(now())
}

model Medico {
  id                   String          @id @default(cuid())
  nombre               String
  apellido             String
  matricula            String?         @unique
  especialidadId       String
  especialidad         Especialidad    @relation(fields: [especialidadId], references: [id])
  telefono             String?
  email                String?
  duracionTurnoMinutos Int             @default(30)
  activo               Boolean         @default(true)
  color                String          @default("#187e77")
  usuarioInterno       UsuarioInterno?
  horarios             HorarioMedico[]
  bloqueos             BloqueoMedico[]
  turnos               Turno[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([especialidadId])
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

// Disponibilidad recurrente semanal. Los horarios disponibles para reservar
// se calculan en el momento (horario base - turnos ya tomados - bloqueos).
model HorarioMedico {
  id            String    @id @default(cuid())
  medicoId      String
  medico        Medico    @relation(fields: [medicoId], references: [id])
  diaSemana     DiaSemana
  horaInicio    String
  horaFin       String
  duracionTurno Int?
  vigenteDesde  DateTime?
  vigenteHasta  DateTime?
  createdAt     DateTime  @default(now())

  @@index([medicoId])
}

enum EstadoBloqueo {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Las licencias se registran directamente. PENDIENTE se conserva para datos anteriores.
model BloqueoMedico {
  id            String          @id @default(cuid())
  medicoId      String
  medico        Medico          @relation(fields: [medicoId], references: [id])
  fecha         DateTime
  horaInicio    String?
  horaFin       String?
  motivo        String?
  estado        EstadoBloqueo   @default(APROBADO)
  aprobadoPorId String?
  aprobadoPor   UsuarioInterno? @relation(fields: [aprobadoPorId], references: [id])
  createdAt     DateTime        @default(now())

  @@index([medicoId])
  @@index([fecha])
}

// ===================== TURNOS =====================

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  LLEGO
  EN_ESPERA
  EN_CONSULTA
  CANCELADO
  AUSENTE
  ATENDIDO
}

enum CanalReserva {
  ONLINE
  TELEFONO
  PRESENCIAL
}

model Turno {
  id                             String           @id @default(cuid())
  pacienteId                     String
  paciente                       Paciente         @relation(fields: [pacienteId], references: [id])
  medicoId                       String
  medico                         Medico           @relation(fields: [medicoId], references: [id])
  fecha                          DateTime
  horaInicio                     String
  horaFin                        String
  estado                         EstadoTurno      @default(PENDIENTE)
  motivoConsulta                 String?
  canalReserva                   CanalReserva     @default(ONLINE)
  notasSecretaria                String?
  notasMedico                    String?
  // Control de concurrencia optimista: se verifica antes de sobreescribir.
  version                        Int              @default(0)
  requiereReprogramacion         Boolean          @default(false)
  reprogramacionId               String?
  avisoReprogramacionEnviado     Boolean          @default(false)
  avisoReprogramacionError       String?
  avisoReprogramacionIntentadoEl DateTime?
  // Evita mandar el recordatorio de 24-48hs mas de una vez para el mismo turno.
  recordatorioEnviado            Boolean          @default(false)
  recordatorioError              String?
  recordatorioIntentadoEl        DateTime?
  revisionesNotas                RevisionNota[]
  historial                      HistorialTurno[]
  avisos                         AvisoTurno[]
  pagos                          Pago[]
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  @@index([medicoId, fecha])
  @@index([pacienteId])
  @@index([requiereReprogramacion, avisoReprogramacionEnviado])
}

enum AccionHistorialTurno {
  CREADO
  MODIFICADO
  CANCELADO
}

// Auditoria: quien hizo que y cuando sobre cada turno.
model HistorialTurno {
  id           String               @id @default(cuid())
  turnoId      String
  turno        Turno                @relation(fields: [turnoId], references: [id])
  accion       AccionHistorialTurno
  realizadoPor String
  detalle      String?
  fecha        DateTime             @default(now())

  @@index([turnoId])
}

// ===================== FACTURACION =====================

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

// Un turno puede tener mas de un pago (ej: sena + resto, o una correccion).
// No hay catalogo de precios: el monto lo carga la secretaria al momento
// de cobrar, para no forzar una lista de precios que esta fuera de alcance.
model Pago {
  id              String     @id @default(cuid())
  turnoId         String
  turno           Turno      @relation(fields: [turnoId], references: [id])
  monto           Decimal    @db.Decimal(10, 2)
  metodo          MetodoPago @default(EFECTIVO)
  notas           String?
  registradoPor   String
  anuladoEl       DateTime?
  anuladoPor      String?
  motivoAnulacion String?
  fecha           DateTime   @default(now())

  @@index([turnoId])
  @@index([fecha])
  @@index([anuladoEl])
}

// ===================== USUARIOS INTERNOS =====================
// Secretaria / Medico / Admin. El paciente nunca tiene usuario propio.

enum RolInterno {
  ADMIN
  SECRETARIA
  MEDICO
}

model UsuarioInterno {
  id                String            @id @default(cuid())
  nombre            String
  email             String            @unique
  password          String
  rol               RolInterno        @default(SECRETARIA)
  // Si el usuario es un medico, queda vinculado a su ficha de Medico.
  medicoId          String?           @unique
  medico            Medico?           @relation(fields: [medicoId], references: [id])
  activo            Boolean           @default(true)
  // Fuerza bruta de login: igual criterio que en ml-afiliados.
  intentosFallidos  Int               @default(0)
  bloqueadoHasta    DateTime?
  versionSesion     Int               @default(0)
  recuperaciones    RecuperacionCuenta[]
  borradores        BorradorClinico[]
  // Pantallas a las que puede entrar (lista JSON de claves). null = todas
  // (admin). No aplica a MEDICO, que siempre ve solo su propia agenda.
  permisos          String?
  bloqueosAprobados BloqueoMedico[]
  notasPacientes    NotaPaciente[]
  archivosPacientes ArchivoPaciente[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// Códigos de un uso; no se almacena el código ni se crea una cuenta.
model VerificacionPaciente {
  id          String    @id
  dni         String
  pacienteId  String?
  email       String?
  // Snapshot del teléfono al momento de pedir el código (igual criterio que
  // email): si el contacto cambia antes de confirmar, el código deja de
  // acreditar acceso. Solo se usa para habilitar el envío por WhatsApp.
  telefono    String?
  proposito   String
  codigoHash  String
  intentos    Int       @default(0)
  consumidoEl DateTime?
  venceEl     DateTime
  createdAt   DateTime  @default(now())

  @@index([venceEl])
}

model LimiteSolicitud {
  clave    String   @id
  cantidad Int      @default(1)
  venceEl  DateTime

  @@index([venceEl])
}

model RevisionFicha {
  id           String   @id @default(cuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  version      Int
  realizadoPor String
  anterior     Json
  posterior    Json
  fecha        DateTime @default(now())

  @@index([pacienteId, fecha])
}

model RevisionNota {
  id           String   @id @default(cuid())
  turnoId      String
  turno        Turno    @relation(fields: [turnoId], references: [id])
  version      Int
  realizadoPor String
  anterior     String?
  posterior    String?
  fecha        DateTime @default(now())

  @@index([turnoId, fecha])
}

model NotaPaciente {
  id         String         @id @default(cuid())
  pacienteId String
  paciente   Paciente       @relation(fields: [pacienteId], references: [id])
  contenido  String
  autorId    String
  autor      UsuarioInterno @relation(fields: [autorId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([pacienteId, createdAt])
}

model ArchivoPaciente {
  id         String         @id @default(cuid())
  pacienteId String
  paciente   Paciente       @relation(fields: [pacienteId], references: [id])
  nombre     String
  tipo       String
  tamanio    Int
  contenido  Bytes
  autorId    String
  autor      UsuarioInterno @relation(fields: [autorId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([pacienteId, createdAt])
}

model RevisionDatosPaciente {
  id           String   @id @default(cuid())
  pacienteId   String
  paciente     Paciente @relation(fields: [pacienteId], references: [id])
  version      Int
  realizadoPor String
  anterior     Json
  posterior    Json
  fecha        DateTime @default(now())

  @@index([pacienteId, fecha])
}

model BorradorClinico {
  id           String         @id @default(cuid())
  usuarioId    String
  usuario      UsuarioInterno @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pacienteId   String
  paciente     Paciente       @relation(fields: [pacienteId], references: [id])
  tipo         String
  referenciaId String
  versionBase  Int
  revision     Int            @default(1)
  contenido    Json
  updatedAt    DateTime       @updatedAt

  @@unique([usuarioId, tipo, referenciaId])
}

model RecuperacionCuenta {
  tokenHash    String         @id
  usuarioId    String
  usuario      UsuarioInterno @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  versionSesion Int
  venceEl      DateTime
  consumidoEl  DateTime?
  createdAt    DateTime       @default(now())

  @@index([venceEl])
}

model AvisoTurno {
  id           String   @id @default(cuid())
  turnoId      String
  turno        Turno    @relation(fields: [turnoId], references: [id])
  tipo         String
  fecha        DateTime
  horaInicio   String
  medicoId     String
  enviado      Boolean  @default(false)
  descartado   Boolean  @default(false)
  intentos     Int      @default(0)
  error        String?
  canal        String?
  intentadoEl  DateTime?
  createdAt    DateTime @default(now())

  @@index([enviado, descartado, createdAt])
  @@index([turnoId])
}
